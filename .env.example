# Endpoint webhook n8n (CRM API Gateway)
N8N_CRM_URL=https://n8n.withmiautomation.com/webhook/simple-crm-demo-api

# Diambil dari data table crm_config baris api_key, atau n8n Variable
# CRM_API_KEY kalau diisi. Jangan pernah di-commit.
N8N_CRM_API_KEY=

# Biarkan true sampai dua nilai di atas terisi. Ini satu-satunya env yang
# boleh sampai ke browser.
NEXT_PUBLIC_DEMO_MODE=true
