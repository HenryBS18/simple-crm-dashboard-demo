# Endpoint webhook n8n (CRM API Gateway)
N8N_CRM_URL=https://n8n.withmiautomation.com/webhook/simple-crm-demo-api

# Endpoint webhook kedua untuk action ai.* (CRM AI Gateway).
# Kalau dibiarkan kosong, hanya tab Agen AI yang memakai data contoh —
# papan kanban tetap memakai n8n.
N8N_CRM_AI_URL=

# Diambil dari data table crm_config baris api_key, atau n8n Variable
# CRM_API_KEY kalau diisi. Jangan pernah di-commit.
N8N_CRM_API_KEY=

# Endpoint webhook ketiga untuk action demo.* (CRM Demo Reset).
N8N_CRM_RESET_URL=
